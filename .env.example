# Salin file ini menjadi .env.local lalu isi dengan data asli.
# .env.local tidak ikut di-commit. Semua variabel NEXT_PUBLIC_* di-inline
# saat build, jadi setelah mengubahnya jalankan ulang `bun run dev` / `bun run build`.

# --- Identitas brand ---
NEXT_PUBLIC_APP_NAME=Juragan Tinja
NEXT_PUBLIC_APP_DESCRIPTION=Jasa Sedot WC, Sedot Limbah Industri & Sanitasi, serta Sedot Septic Tank di Bogor, Bekasi, dan sekitarnya. Layanan profesional, cepat, dan terjangkau dengan peralatan modern dan tim berpengalaman.

# WAJIB domain asli saat sudah online (dipakai untuk canonical, sitemap, robots, Open Graph).
NEXT_PUBLIC_APP_URL=https://domainanda.com

NEXT_PUBLIC_APP_TAGLINE=Solusi Cepat & Bersih untuk Masalah Septic Tank Anda

# --- Kontak ---
NEXT_PUBLIC_APP_ADDRESS=Jl. Kranggan, Kel Jatisampurna, Kec. Jatisampurna, Kota Bekasi, Jawa Barat 17433
NEXT_PUBLIC_APP_PHONE=08123456789
NEXT_PUBLIC_APP_WHATSAPP=6281234567890
NEXT_PUBLIC_APP_EMAIL=halo@domainanda.com
NEXT_PUBLIC_APP_OPERATIONAL_HOURS=24 Jam (Senin - Minggu)
NEXT_PUBLIC_APP_FOUNDED_YEAR=2020

# --- Embed peta (Google Maps > Share > Embed a map > salin atribut src) ---
# Gunakan & biasa, bukan &amp;. Kosongkan untuk menampilkan kartu alamat saja.
NEXT_PUBLIC_APP_GOOGLE_MAPS_EMBED_URL=https://maps.google.com/maps?width=600&height=400&hl=id&q=Jl.+Kranggan,+Jatisampurna,+Kota+Bekasi&z=14&ie=UTF8&iwloc=B&output=embed

# --- Galeri: comma-separated, tanpa spasi di awal/akhir tiap item ---
NEXT_PUBLIC_APP_GALLERY_IMAGE=/image/brosur.jpg,/image/work-process.jpg,/image/team-work.jpg,/image/equipment.jpg,/image/septic-tank.jpg

# --- Verifikasi search engine (tanpa prefix NEXT_PUBLIC_) ---
# Diisi setelah verifikasi, lalu build ulang.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
